# Copy outside the source tree with restrictive permissions. No values below are credentials.
HOST=127.0.0.1
PORT=8787
BANK_DATABASE=./data/bank.sqlite
# Optional local directory managed by the offline app-update CLI. No URL or upload endpoint.
APP_UPDATE_DIRECTORY=
BEHIND_HTTPS_PROXY=false
# Choose none / aliyun / supabase. No fake SMS exists in the production entry point.
SMS_PROVIDER=none
# Required only for aliyun/local-generated OTP.
SMS_HMAC_KEY=
ALIYUN_ACCESS_KEY_ID=
ALIYUN_ACCESS_KEY_SECRET=
ALIYUN_SECURITY_TOKEN=
ALIYUN_SMS_SIGN_NAME=
ALIYUN_SMS_TEMPLATE_CODE=
# Supabase phone proof only: fixed HTTPS project origin and a publishable key.
# Legacy anon keys are accepted via the fallback variable; never use secret/service_role.
# Enable phone Auth + a real SMS provider on the upstream project first.
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_ANON_KEY=
# Independent random 32-byte base64 key; store separately from the database backup.
MODEL_MASTER_KEY=
# Coze built-in model execution. Omit all three values to keep the integration unavailable.
# Production origin is fixed to https://d635c6m6jj.coze.site.
# Preview may use the same project's UUID.dev.coze.site origin with DEV explicitly selected.
# COZE_LLM_ORIGIN=https://d635c6m6jj.coze.site
# COZE_LLM_ENVIRONMENT=PROD
# TIYU_LLM_BRIDGE_KEY=
# Alternatively omit TIYU_LLM_BRIDGE_KEY and supply the existing server-only TIYU_GATEWAY_KEY.
# Never expose either bridge secret to the browser or APK; no supplier Key is required for Coze.
