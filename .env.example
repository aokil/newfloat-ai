# Server-only. Supply separately in Coze preview and production environments.
# Fixed public TLS/NAT address; the certificate must include this IP in its SAN.
TIYU_UPSTREAM_URL=https://192.0.2.1:8443
# Base64 of the PEM for the dedicated upstream CA (not the server leaf certificate).
TIYU_UPSTREAM_CA_B64=
# A random, printable ASCII secret of at least 32 characters, shared with the TLS gateway.
TIYU_GATEWAY_KEY=
# Optional dedicated server-to-server LLM bridge secret, shared with the account backend.
# Omit to derive an independent HMAC subkey from TIYU_GATEWAY_KEY; leave unset, not empty.
# TIYU_LLM_BRIDGE_KEY=
# Runtime identity: fixed project metadata is also declared in .coze.
# COZE_PROJECT_ID=7689833705046130729
# COZE_PROJECT_ENV=DEV or PROD (provided by the Coze runtime)
